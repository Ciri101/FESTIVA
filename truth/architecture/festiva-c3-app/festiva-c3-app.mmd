%% name: festiva-c3-app
%% home: festiva-c3-app
flowchart TB
  student["国际学生<br/>[Person]"]
  subgraph ios["iOS App"]
    subgraph vlayer["界面层（View）"]
      signinV["登录界面<br/>注册与登录<br/>[sign-in views · SwiftUI]"]
      joinV["Join 界面<br/>首页、筛选、搜索、详情<br/>[Join views · SwiftUI]"]
      createV["Create 界面<br/>主持的活动、表单<br/>申请通知<br/>[Create views · SwiftUI]"]
      meV["Me 界面<br/>资料、我的申请<br/>收藏、设置<br/>[Me views · SwiftUI]"]
      chatV["对话界面<br/>三个角色共用<br/>含确认卡片<br/>[chat views · SwiftUI]"]
    end
    subgraph vmlayer["视图模型层（ViewModel）"]
      signinVM["登录视图模型<br/>登录流程与会话状态<br/>[sign-in view model]"]
      joinVM["Join 视图模型<br/>推荐、筛选、详情与申请<br/>[Join view model]"]
      createVM["Create 视图模型<br/>创建、编辑、审批<br/>[Create view model]"]
      meVM["Me 视图模型<br/>资料、申请记录、收藏<br/>[Me view model]"]
      chatVM["对话视图模型<br/>消息与确认卡片<br/>确认后才写入<br/>[chat view model]"]
    end
    subgraph mlayer["模型层（Model）"]
      apiClient["业务接口客户端<br/>调用 API 服务的业务接口<br/>[business API client · HTTPS]"]
      chatClient["对话客户端<br/>流式对话<br/>[chat client · 流式 HTTPS]"]
      imageIO["图片存取适配器<br/>上传与加载图片<br/>[image storage adapter]"]
      mapsA["地图适配器<br/>地址转坐标、打开地图<br/>[maps adapter · MapKit]"]
      locA["定位适配器<br/>当前位置与授权<br/>[location adapter · Core Location]"]
      pushR["推送注册器<br/>注册设备、接收推送<br/>[push registrar · APNs]"]
      historyA["对话记录存取适配器<br/>按账号与角色保存对话记录<br/>[chat history storage adapter · SwiftData]"]
    end
  end
  api["API 服务<br/>[Container]"]
  aiSvc["AI 编排服务<br/>[Container]"]
  files["文件存储<br/>[Container]"]
  maps["Apple 地图服务<br/>[External System]"]
  apns["Apple 推送通知服务<br/>[External System]"]
  student -->|"使用"| vlayer
